# Контур: test | qa | dev  (для corp-gateway-test используйте test)
ENV=test

# Base URL of corp-ncins-acc gateway
BASE_URL=http://corp-gateway-test.moscow.alfaintra.net/corp-ncins-acc-gateway/secure/corp-ncins-acc-corp-ncins-acc-api
REQUEST_TIMEOUT=30

# Gateway A-* headers (из NCINS-200)
A_USER_ID=123456
A_CUSTOMER_ID=123456
A_CLIENT_TYPE=XXXXX
A_CHANNEL_ID=XXXXX
A_USER_IP=XXXXX
A_PROJECT_ID=XXXXX

# Keycloak UMP client_credentials (НИБ) — чтобы не было RBAC: access denied
# Секреты по умолчанию подставляются из профиля ENV в config.py.
# При необходимости переопределите:
# KEYCLOAK_TOKEN_URL=https://idp-api-test.alfaintra.net/auth/realms/ump/protocol/openid-connect/token
# KEYCLOAK_CLIENT_ID=nib-corp-ncins
# KEYCLOAK_CLIENT_SECRET=wcpWehuLXKRWwMYE17EXvg9ShCQ7Rovc
KEYCLOAK_VERIFY_SSL=0
FETCH_KEYCLOAK_TOKEN=1

# Или вручную:
# AUTHORIZATION=Bearer <access_token>
