# Контур из Postman: test | dev
ENV=test

# Gateway (по умолчанию подставляется из профиля ENV)
# BASE_URL=http://corp-gateway-test.moscow.alfaintra.net/corp-ncins-acc-gateway/secure/corp-ncins-acc-corp-ncins-acc-api
REQUEST_TIMEOUT=30

# Headers как в Insurance API Tests (collection variables)
A_USER_ID=123456
A_CUSTOMER_ID=123456
A_CLIENT_TYPE=MOBILE
A_CHANNEL_ID=INTERNET
# Эти два в Postman не используются — можно оставить пустыми
A_USER_IP=
A_PROJECT_ID=

# Token из Postman: mks-gateway / realm corporate
# client_id=nib-corp-ncinsurance-accounting
# (дефолты уже в config.py для ENV=test|dev)
FETCH_KEYCLOAK_TOKEN=1
KEYCLOAK_VERIFY_SSL=0

# KEYCLOAK_TOKEN_URL=http://corp-gateway-test.moscow.alfaintra.net/mks-gateway/public/auth/realms/corporate/protocol/openid-connect/token
# KEYCLOAK_CLIENT_ID=nib-corp-ncinsurance-accounting
# KEYCLOAK_CLIENT_SECRET=nib_corp_ncinsurance_accounting
