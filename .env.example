# Контур: test | dev
ENV=test

# Gateway create-operation (дефолт из профиля ENV)
# BASE_URL=https://corp-gateway-test.moscow.alfaintra.net/corp-ncins-gateway/secure/corp-ncins-corp-ncins-api
REQUEST_TIMEOUT=30
API_VERIFY_SSL=0

# Headers из curl create-operation
A_USER_ID=123456
A_CUSTOMER_ID=123456
A_CLIENT_TYPE=MOBILE
A_CHANNEL_ID=nib
A_PROJECT_ID=corp-ncinsurance
A_USER_IP=

# Body defaults из curl
BODY_USER_ID=XAGA56
BODY_CLIENT_ID=UAY4DP
BODY_DOCUMENT_ID=3fa85f64-5717-4562-b3fc-2c963f66afa6

# Token: mks-gateway / realm corporate (как в Postman Insurance API Tests)
FETCH_KEYCLOAK_TOKEN=1
KEYCLOAK_VERIFY_SSL=0

# KEYCLOAK_TOKEN_URL=http://corp-gateway-test.moscow.alfaintra.net/mks-gateway/public/auth/realms/corporate/protocol/openid-connect/token
# KEYCLOAK_CLIENT_ID=nib-corp-ncinsurance-accounting
# KEYCLOAK_CLIENT_SECRET=nib_corp_ncinsurance_accounting
